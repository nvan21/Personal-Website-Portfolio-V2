---
import Navbar from "../components/Navbar.astro";
import { links } from "../data/portfolio";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nathan Van Utrecht | Robotics Engineer & Researcher",
  description = "Nathan Van Utrecht is a robotics MS student working on dexterous manipulation, perception, and robot learning.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fafaf8"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0e0f11"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/headshot.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("portfolio-theme");
        if (theme === "light" || theme === "dark")
          document.documentElement.dataset.theme = theme;
      } catch {
        /* Fall back to the system preference. */
      }
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer" id="contact">
      <div class="site-shell">
        <p class="footer-note">
          Open to robotics, robot learning, and autonomy roles. Email is the
          fastest way to reach me.
        </p>
        <dl class="contact-block">
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${links.email}`}>{links.email}</a></dd>
          </div>
          <div>
            <dt>Elsewhere</dt>
            <dd class="contact-links">
              <a href={links.github} target="_blank" rel="noreferrer">GitHub</a>
              <a href={links.linkedin} target="_blank" rel="noreferrer"
                >LinkedIn</a
              >
              <a href={links.cv} target="_blank" rel="noreferrer">CV</a>
            </dd>
          </div>
        </dl>
      </div>
    </footer>
  </body>
</html>
