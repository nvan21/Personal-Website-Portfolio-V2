---
import { experience } from "../data/portfolio";
---

<section
  id="experience"
  class="sheet-section"
  aria-labelledby="experience-title"
>
  <div class="site-shell section-grid">
    <header class="section-label">
      <h2 id="experience-title">Experience</h2>
      <p>
        {experience.filter((r) => r.kind === "Research").length} research,
        {experience.filter((r) => r.kind === "Industry").length} industry
      </p>
    </header>
    <table class="exp-table">
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Where</th>
          <th scope="col">Notes</th>
        </tr>
      </thead>
      <tbody>
        {
          experience.map((r) => (
            <tr class:list={{ "is-current": r.current }}>
              <td class="exp-date">{r.date}</td>
              <th scope="row" class="exp-where">
                <strong>{r.org}</strong>
                <span>
                  {r.role}, {r.place}
                </span>
                <em class:list={["exp-kind", r.kind.toLowerCase()]}>
                  {r.kind}
                </em>
              </th>
              <td class="exp-notes">
                <p set:html={r.notes} />
                {r.links && (
                  <p class="exp-links">
                    {r.links.map((l) => (
                      <a href={l.href} target="_blank" rel="noreferrer">
                        [{l.label}]
                      </a>
                    ))}
                  </p>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
